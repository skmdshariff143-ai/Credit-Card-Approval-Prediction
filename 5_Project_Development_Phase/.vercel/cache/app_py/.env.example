# =========================================================
# CreditGuard AI - Environment Variables Template
# =========================================================

# Flask Server Config
FLASK_ENV=development
SECRET_KEY=default_development_secret_key_12345
PORT=5000

# Pipeline Model Paths
MODEL_PATH=models/best_model.pkl
ENCODER_PATH=models/encoder.pkl
SCALER_PATH=models/scaler.pkl

# IBM Cloud Watson ML Credentials
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_REGION=us-south
IBM_PROJECT_ID=your_ibm_watson_project_id_here
IBM_SPACE_ID=your_ibm_watson_space_id_here
IBM_SCORING_URL=your_ibm_scoring_url_here
