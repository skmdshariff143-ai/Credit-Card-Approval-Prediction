# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your_dev_secret_key_here
PORT=5000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# IBM Cloud Watson ML Credentials
IBM_API_KEY=your_ibm_api_key_here
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_INSTANCE_ID=your_ibm_instance_id_here
IBM_SPACE_ID=your_ibm_space_id_here
IBM_SCORING_URL=your_ibm_scoring_url_here

# Vercel Deployment Flag
VERCEL=0

# Seed Administrator Account (optional setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Seed Loan Officer Account (optional setup)
OFFICER_USERNAME=officer
OFFICER_EMAIL=officer@creditguard.ai
OFFICER_PASSWORD=Officer@123

# Seed Client User Account (optional setup)
DEMO_USERNAME=demo
DEMO_EMAIL=demo@creditguard.ai
DEMO_PASSWORD=Demo@123
