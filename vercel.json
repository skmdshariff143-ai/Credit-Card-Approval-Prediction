{
  "version": 2,
  "builds": [
    {
      "src": "5_Project_Development_Phase/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{1_Brainstorming_and_Ideation/**,2_Requirement_Analysis/**,3_Project_Design_Phase/**,4_Project_Planning_Phase/**,6_Project_Testing/**,7_Project_Documentation/**,8_Project_Demonstration/**,5_Project_Development_Phase/data/**,5_Project_Development_Phase/notebooks/**,5_Project_Development_Phase/logs/**,5_Project_Development_Phase/diagrams/**,5_Project_Development_Phase/tests/**,5_Project_Development_Phase/docs/**,5_Project_Development_Phase/demo/**,5_Project_Development_Phase/interview/**,5_Project_Development_Phase/reports/**,5_Project_Development_Phase/resume/**,5_Project_Development_Phase/screenshots/**,screenshots/**,5_Project_Development_Phase/credit_card_approval_prediction.egg-info/**,5_Project_Development_Phase/models/artifacts/**,5_Project_Development_Phase/models/trained/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "^/robots\\.txt$",
      "dest": "/5_Project_Development_Phase/index.py",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/5_Project_Development_Phase/index.py",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "^/google482d22f42a897fe4\\.html$",
      "dest": "/5_Project_Development_Phase/index.py",
      "headers": {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/5_Project_Development_Phase/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/5_Project_Development_Phase/index.py"
    }
  ]
}
