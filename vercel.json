{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{data/**,notebooks/**,logs/**,diagrams/**,tests/**,docs/**,demo/**,interview/**,reports/**,resume/**,screenshots/**,credit_card_approval_prediction.egg-info/**,models/artifacts/**,models/trained/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "index.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ]
}
